# scripts.setup writes .env from the platform's handshake file (.env.bridge). Options:
# LAUNCHER_TOKEN=generated
# PLATFORM_NETWORK=iceberg-platform_default
# DBT_PORT=3004
# MAX_CONCURRENT_RUNS=4
# RUN_TIMEOUT_SECONDS=2700   # at most 3000: platform tokens last one hour
# RUN_MEMORY=2g
# RUN_CPUS=2
# RUNNER_IMAGE=iceberg-dbt-runner:0.1.0
