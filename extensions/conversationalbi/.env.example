# scripts.setup writes .env from the platform's handshake file (.env.bridge). Options:
# RUNTIME_KEY=generated               # identifies the CopilotKit runtime to the agent listener
# PLATFORM_NETWORK=iceberg-platform_default
# CBI_PORT=3007
# LLM_MODEL and its provider's credentials are not here: scripts.setup writes them to llm.env.
# BI_LLM_ROWS=20                      # result rows the LLM may see per query; 0 sends none
# BI_LLM_BYTES=8192                   # size cap of those rows, up to 65536
# BI_MAX_ROWS=5000                    # rows a query may return to charts and tables, at most 5000
# BI_QUERY_TIMEOUT=30
# BI_MAX_QUERIES=4                    # queries running at the same time
# CBI_MEMORY=3g
