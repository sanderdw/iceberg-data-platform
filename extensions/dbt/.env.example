# scripts.setup writes .env from the platform's handshake file (.env.bridge). Options:
# LAUNCHER_TOKEN=generated
# PLATFORM_NETWORK=iceberg-platform_default
# DBT_PORT=3004
# MAX_CONCURRENT_RUNS=4     # runs at once, across all teams
# MAX_RUNS_PER_TEAM=2       # runs at once per team; more of one team wait in line
# RUN_RETENTION=30          # finished runs per project and environment that keep their log and files
# RUN_TIMEOUT_SECONDS=43200  # a run ends 15 minutes before its catalog token expires, whose lifetime the
#                           # platform sets (POLARIS_TOKEN_LIFETIME, 1 hour by default); this only lowers it
# RUN_MEMORY=2g
# RUN_CPUS=2
# RUNNER_IMAGE=            # defaults to the runner image of this release (compose.yaml)
