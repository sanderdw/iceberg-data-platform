# scripts.setup writes .env from the platform's handshake file (.env.bridge). Options:
# LAUNCHER_TOKEN=generated
# ING_SECRET_KEY=generated   # AES-GCM key for source secrets; losing it means setting every secret again
# PLATFORM_NETWORK=iceberg-platform_default
# ING_PORT=3008
# ING_MAX_CONCURRENT_RUNS=4  # runs at once, across all teams
# ING_MAX_RUNS_PER_TEAM=2    # runs at once per team; more of one team wait in line
# ING_RUN_RETENTION=30       # finished runs per pipeline that keep their log
# ING_RUN_TIMEOUT_SECONDS=43200  # a run ends 15 minutes before its catalog token expires, whose lifetime the
#                            # platform sets (POLARIS_TOKEN_LIFETIME, 1 hour by default); this only lowers it
# ING_ALLOW_PRIVATE_SOURCES=false  # true lets pipelines read sources on private addresses, such as a database
#                            # on this machine (host.docker.internal). For demos on a laptop only.
# RUN_MEMORY=2g
# RUN_CPUS=2
# RUNNER_IMAGE=              # defaults to the runner image of this release (compose.yaml)
