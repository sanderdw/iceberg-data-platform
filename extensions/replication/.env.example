# scripts.setup writes .env from the platform's handshake file (.env.bridge). Options:
# LAUNCHER_TOKEN=generated
# REP_SECRET_KEY=generated   # AES-GCM key for source passwords; losing it means setting every password again
# PLATFORM_NETWORK=iceberg-platform_default
# REP_PORT=3014
# REP_MAX_CONCURRENT_RUNS=4  # runs at once, across all teams (source checks included)
# REP_MAX_RUNS_PER_TEAM=2    # runs at once per team; more of one team wait in line
# REP_RUN_RETENTION=30       # finished runs per replication that keep their log
# REP_RUN_TIMEOUT_SECONDS=43200  # a run ends 15 minutes before its catalog token expires, whose lifetime the
#                            # platform sets (POLARIS_TOKEN_LIFETIME, 1 hour by default); this only lowers it
# REP_ALLOWED_SOURCE_NETWORKS=  # private networks of your operational databases, such as 10.20.0.0/16,192.168.5.0/24.
#                            # Loopback and link-local addresses stay refused.
# REP_ALLOW_PRIVATE_SOURCES=false  # true lifts every address rule, such as for a database on this machine
#                            # (host.docker.internal). For demos on a laptop only.
# RUN_MEMORY=4g              # OLake's reader and Java writer; a large burst of changes needs more
# RUN_CPUS=2
# RUNNER_IMAGE=              # defaults to the runner image of this release (compose.yaml)
