# scripts.setup writes .env from the platform's handshake file (.env.bridge). Options:
# LAUNCHER_TOKEN=generated
# PLATFORM_NETWORK=iceberg-platform_default
# MNT_PORT=3013
# MNT_MAX_CONCURRENT_RUNS=2  # runs at once, across all teams; one database never has two
# MNT_RUN_RETENTION=30       # finished runs per database that keep their log and results
# MNT_RUN_TIMEOUT_SECONDS=43200  # a run ends 15 minutes before its catalog token expires, whose lifetime the
#                            # platform sets (POLARIS_TOKEN_LIFETIME, 1 hour by default); this only lowers it
# RUN_MEMORY=2g              # compaction holds about one file group in memory; raise it with larger targets
# RUN_CPUS=2
# RUNNER_IMAGE=              # defaults to the runner image of this release (compose.yaml)
