# scripts.setup writes .env from the platform's handshake file (.env.bridge). Options:
# PLATFORM_NETWORK=iceberg-platform_default
# EVAL_PORT=3012
# AGENT_URL=http://cbi-gateway:3007   # Conversational BI, the agent under evaluation
# EVAL_MAX_RUNS=2           # evaluation runs at once, across all teams
# EVAL_CONCURRENCY=2        # questions of one run asked at once
# EVAL_RUN_RETENTION=50     # finished runs per question set whose case results are kept here
# JUDGE_MODEL=              # an LLM for the judge scorers (Pydantic AI model string); its key in llm.env
