# scripts.setup writes .env from the platform's handshake file (.env.bridge). Options:
# OM_URL=http://openmetadata-server:8585/api  # the OpenMetadata API, reachable from the om-sync container
# OM_JWT_TOKEN=                # the JWT of an OpenMetadata bot, such as ingestion-bot (Settings > Bots)
# OM_SERVICE_PREFIX=iceberg    # names this platform's services, metrics and data products; one per installation
# OM_DOMAIN=Iceberg Data Platform  # the domain of the data products; created when missing
# OM_POLL_SECONDS=60           # how often listing changes are picked up
# OM_FULL_SYNC_SECONDS=900     # how often everything is published again, including schema and model edits
# OM_VERIFY_TLS=true
# OM_UI_URL=https://metadata.example.com  # where people browse OpenMetadata; the user portal's link opens it
# PLATFORM_NETWORK=iceberg-platform_default
# OM_PORT=3011
