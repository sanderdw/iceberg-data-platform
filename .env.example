# Generate .env with uv run python -m scripts.setup. All credentials below are local development only.
PORT=3000
HOST=127.0.0.1
PORTAL_PASSWORD=replace-with-generated-password
PROVIDER=polaris
POLARIS_URL=http://localhost:8181
POLARIS_PUBLIC_URL=http://localhost:8181
POLARIS_CLIENT_ID=portal-admin
POLARIS_CLIENT_SECRET=replace-with-generated-secret
POSTGRES_PASSWORD=replace-with-generated-password
RUSTFS_ACCESS_KEY=iceberg-local
RUSTFS_SECRET_KEY=replace-with-generated-secret
S3_ENDPOINT=http://localhost:9000
S3_INTERNAL_ENDPOINT=http://rustfs:9000
S3_ADMIN_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1

# Separate user portal, sharing this stack's Polaris and RustFS
USER_PORT=3002
USER_COOKIE_SECURE=false
PORTAL_LAN_IP=
CATALOG_DOCKER_NETWORK=iceberg-platform_default
POLARIS_CONTAINER=iceberg-platform-polaris-1
RUSTFS_CONTAINER=iceberg-platform-rustfs-1
MAX_NOTEBOOKS=8
NOTEBOOK_MEMORY=1g
