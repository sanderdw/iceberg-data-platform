{
  "name": "principles-explainer",
  "private": true,
  "version": "1.0.0",
  "description": "Animated explainer: four engineering principles shown on the Iceberg Data Platform",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "voice": "uv run tts/generate.py",
    "music": "uv run audio/make_music.py",
    "still": "remotion still src/index.ts",
    "render": "remotion render src/index.ts Explainer out/principles-you-can-see.mp4 --codec=h264 --crf=18 --audio-bitrate=256k",
    "render:4k": "remotion render src/index.ts Explainer out/principles-you-can-see-4k.mp4 --codec=h264 --crf=18 --audio-bitrate=256k --scale=2",
    "typecheck": "tsc --noEmit",
    "stills": "node scripts/stills.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.533",
    "@remotion/cli": "4.0.533",
    "@remotion/renderer": "4.0.533",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
