# Two public addresses in front of the platform. Each tunnel reaches one site block.
{
	auto_https off
	servers {
		# Keep the tunnel's X-Forwarded-Proto: https instead of replacing it with http.
		trusted_proxies static private_ranges
	}
}

# Administration portal and Keycloak sign-in. Keycloak stays off the user portal's address
# because notebooks run user-authored content there. The Keycloak administration console and
# master realm stay internal; the portals reach Keycloak's admin API at http://keycloak:8080.
:8080 {
	@internal path /admin /admin/* /realms/master /realms/master/*
	@keycloak path /realms/* /resources/*
	route {
		respond @internal 404
		reverse_proxy @keycloak keycloak:8080
		reverse_proxy portal:3000
	}
}

# Everything a participant uses: the user portal, the Iceberg REST catalog of Polaris and the
# S3 API of RustFS. Only /api/catalog of Polaris is public, never /api/management. S3 requests
# are recognised by their AWS signature, so the RustFS console and unsigned requests never reach it.
:8081 {
	@catalog path /api/catalog/*
	@s3 {
		header Authorization AWS4-HMAC-SHA256*
	}
	@s3presigned query X-Amz-Algorithm=AWS4-HMAC-SHA256
	route {
		reverse_proxy @catalog polaris:8181
		reverse_proxy @s3 rustfs:9000
		reverse_proxy @s3presigned rustfs:9000
		reverse_proxy users:3002
	}
}
